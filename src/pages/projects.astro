---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import SearchBar from '@/components/SearchBar.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Projects" />
  <Breadcrumbs items={[{ label: 'Projects', icon: 'lucide:briefcase' }]} />

  <!-- Search Bar for Projects -->
  <div class="mt-2 mb-6 sm:mt-6">
    <SearchBar pageType="project" />
  </div>

  <div class="flex min-h-[50vh] flex-col items-center justify-center gap-4">
    <h2
      class="upcoming-text tracking-title font-[family-name:var(--font-heading)] text-2xl font-bold"
    >
      Upcoming<span class="dots"
        ><span>.</span><span>.</span><span>.</span></span
      >
    </h2>
    <p class="text-muted-foreground text-sm">
      Stay tuned for exciting projects
    </p>
  </div>

  <style>
    .upcoming-text .dots span {
      animation: dotFade 1.4s infinite;
      opacity: 0;
    }

    .upcoming-text .dots span:nth-child(1) {
      animation-delay: 0s;
    }
    .upcoming-text .dots span:nth-child(2) {
      animation-delay: 0.2s;
    }
    .upcoming-text .dots span:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes dotFade {
      0%,
      20% {
        opacity: 0;
      }
      50% {
        opacity: 1;
      }
      80%,
      100% {
        opacity: 0;
      }
    }
  </style>
</Layout>
